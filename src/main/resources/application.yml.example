spring:
  datasource:
    url: jdbc:mysql://localhost:3306/gymmanager?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: root
    password: ${DB_PASSWORD}
pagehelper:
  reasonable: true
  defaultCount: true
  helperDialect: mysql
logging:
  level:
    com.example.gymmanagement.mapper: debug
mybatis-plus:
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl